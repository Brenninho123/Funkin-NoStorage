  static final FEATURE_SCREENSHOTS:FeatureFlag = "FEATURE_SCREENSHOTS";
  static final FEATURE_HAXEUI:FeatureFlag = "FEATURE_HAXEUI";
  static final FEATURE_DEBUG_MENU:FeatureFlag = "FEATURE_DEBUG_MENU";
  static final FEATURE_ANIMATION_EDITOR:FeatureFlag = "FEATURE_ANIMATION_EDITOR";
  static final FEATURE_CHART_EDITOR:FeatureFlag = "FEATURE_CHART_EDITOR";
  static final FEATURE_STAGE_EDITOR:FeatureFlag = "FEATURE_STAGE_EDITOR";
  static final FEATURE_TOUCH_CONTROLS:FeatureFlag = "FEATURE_TOUCH_CONTROLS";
  static final FEATURE_TOUCH_HERE_TO_PLAY:FeatureFlag = "FEATURE_TOUCH_HERE_TO_PLAY";
  static final FEATURE_VIDEO_PLAYBACK:FeatureFlag = "FEATURE_VIDEO_PLAYBACK";
  static final FEATURE_VIDEO_SUBTITLES:FeatureFlag = "FEATURE_VIDEO_SUBTITLES";
  static final FEATURE_DEBUG_DISPLAY:FeatureFlag = "FEATURE_DEBUG_DISPLAY";

  public function new()
  {
    super();

    #if !target.unicode
    if (isWindowsHost())
    {
      Sys.command("chcp 65001 > nul");
    }
    #end

    envConfig = readEnvironmentFile(ENV_FILE);

    flair();
    displayTarget();
    configureApp();
    configureOutputDir();

    if (isRun() || isInstall()) return;

    configureFeatureFlags();
    configureWindowBackground();
    configureCompileDefines();
    configureIncludeMacros();
    configureCustomMacros();
    configurePolymod();
    configureHaxelibs();
    configureASTCTextures();
    configureAssets();

    if (!isLinux()) configureIcons();

    if (FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this)) configureAdMobKeys();

    if (isAndroid()) configureAndroid();

    if (isIOS()) configureIOS();

    if (isCPP()) buildHxCppTools();

    if (!(isDisplay() || isCleanCommand())) checkLibraries();
  }

  function flair():Void
  {
    info('$TITLE - $VERSION');
    info("Initializing build...");
    info("Git Branch:     " + getGitBranch());
    info("Git Commit:     " + getGitCommit());
    info("Git Modified?   " + getGitModified());
    info("Display?        " + isDisplay());
  }

  function configureApp():Void
  {
    this.meta.title = isMobile() ? TITLE_MOBILE : TITLE;
    this.meta.version = VERSION;
    this.meta.packageName = PACKAGE_NAME;
    this.meta.company = COMPANY;
    this.meta.buildNumber = Std.string(BUILD_NUMBER);

    this.app.main = MAIN_CLASS;
    this.app.file = EXECUTABLE_NAME;
    this.app.preloader = PRELOADER;

    this.sources.push(SOURCE_DIR);
    this.templatePaths.push(TEMPLATES_DIR);

    this.preBuildCallbacks.push(buildHaxeCLICommand(PREBUILD_HX));
    this.postBuildCallbacks.push(buildHaxeCLICommand(POSTBUILD_HX));

    this.languages = LANGUAGES;

    this.window.fps = 60;
    this.window.width = 1280;
    this.window.height = 720;
    this.window.background = 0xFF000000;
    this.window.hardware = true;
    this.window.vsync = false;
    this.window.allowHighDPI = !isMac();

    if (isWeb())
    {
      this.window.resizable = true;
    }

    if (isDesktop())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = false;
      this.window.resizable = true;
    }

    if (isMobile())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = true;
      this.window.resizable = false;
      this.window.borderless = true;
      this.window.width = 0;
      this.window.height = 0;
    }

    if (isAndroid()) configureAndroidApp();

    if (isIOS())
    {
      config.set("ios.non-exempt-encryption", "false");
      config.set("ios.team-id", IOS_TEAM_ID);
      config.set("ios.deployment", IOS_DEPLOYMENT);
    }
  }

  function configureAndroidApp():Void
  {
    if (EXCLUDE_ARMV7.isEnabled(this))
    {
      this.excludeArchitectures.push(Architecture.ARMV7);
    }

    if (!isRelease()) return;

    final keystorePath:Null<String> = getEnv("KEYSTORE_PATH");

    if (keystorePath != null)
    {
      keystore = new Keystore();
      keystore.path = keystorePath;
      keystore.alias = getEnvOr("KEYSTORE_ALIAS", "");
      keystore.password = getEnvOr("KEYSTORE_PASSWORD", "");
    }

    if (isBundle())
    {
      config.set("android.gradle-project-directory", "bin-bundle");
    }
  }

  function configureWindowBackground():Void
  {
    this.window.background = FEATURE_DEBUG_FUNCTIONS.isEnabled(this) ? 0xFFFF00FF : 0xFF000000;
  }

  function displayTarget():Void
  {
    switch (this.target)
    {
      case Platform.WINDOWS:
        info("Target Platform: Windows");
      case Platform.MAC:
        info("Target Platform: MacOS");
      case Platform.LINUX:
        info("Target Platform: Linux");
      case Platform.ANDROID:
        info("Target Platform: Android");
      case Platform.IOS:
        info("Target Platform: iOS");
      case Platform.HTML5:
        info("Target Platform: HTML5");
      default:
        error('Unsupported platform (got ${target})');
    }

    switch (this.platformType)
    {
      case PlatformType.DESKTOP:
        info("Target Platform Type: Desktop");
      case PlatformType.MOBILE:
        info("Target Platform Type: Mobile");
      case PlatformType.WEB:
        info("Target Platform Type: Web");
      case PlatformType.CONSOLE:
        info("Target Platform Type: Console");
      default:
        error('Unknown platform type (got ${platformType})');
    }

    if (isWeb())
    {
      info("Target Language: JavaScript (HTML5)");
    }
    else if (isCPP())
    {
      info("Target Language: C++");
    }
    else
    {
      error("Unsupported target language!");
    }

    for (arch in this.architectures)
    {
      switch (arch)
      {
        case Architecture.X86:
          info("Target Architecture: x86");
        case Architecture.X64:
          info("Target Architecture: x64");
        case Architecture.ARMV7:
          info("Target Architecture: ARMv7");
        case Architecture.ARM64:
          info("Target Architecture: ARM64");
        case null:
          if (isWeb()) info("Target Architecture: Web");
          else error("Unsupported architecture (got null on non-web platform)");
        default:
          error('Unsupported architecture (got ${arch})');
      }
    }
  }

  function configureFeatureFlags():Void
  {
    final mobileRelease:Bool = isMobile() && isRelease();
    final editorsAvailable:Bool = !(isWeb() || isMobile());

    GITHUB_BUILD.apply(this, false);
    EXCLUDE_ARMV7.apply(this, false);
    HARDCODED_CREDITS.apply(this, true);
    UNLOCK_EVERYTHING.apply(this, true);
    EMBED_ASSETS.apply(this, isWeb());
    PRELOAD_ALL.apply(this, !isWeb());
    REDIRECT_ASSETS_FOLDER.apply(this, isDebug() && isDesktop());
    CENSOR_EXPLETIVES.apply(this, isMobile());
    FORCE_BLEND_SHADER.apply(this, isAndroid());

    FEATURE_DEBUG_FUNCTIONS.apply(this, isDebug() || GITHUB_BUILD.isEnabled(this));

    final debugFunctions:Bool = FEATURE_DEBUG_FUNCTIONS.isEnabled(this);

    FEATURE_RESULTS_DEBUG.apply(this, isDebug() || GITHUB_BUILD.isEnabled(this));
    FEATURE_DEBUG_FILE_LOGGING.apply(this, debugFunctions);
    FEATURE_DEBUG_DISPLAY.apply(this, !isMobile() || debugFunctions);

    FEATURE_FUNKVIS.apply(this, true);
    FEATURE_LOG_TRACE.apply(this, true);
    FEATURE_NAUGHTYNESS.apply(this, true);
    FEATURE_OPEN_URL.apply(this, true);
    FEATURE_PARTIAL_SOUNDS.apply(this, true);
    FEATURE_POLYMOD_MODS.apply(this, true);

    FEATURE_VIDEO_PLAYBACK.apply(this, true);
    FEATURE_VIDEO_SUBTITLES.apply(this, FEATURE_VIDEO_PLAYBACK.isEnabled(this) && !isWeb());

    FEATURE_DISCORD_RPC.apply(this, isDesktop() && !debugFunctions);
    FEATURE_LOST_FOCUS_VOLUME.apply(this, isDesktop());

    FEATURE_NEWGROUNDS.apply(this, true);

    final newgrounds:Bool = FEATURE_NEWGROUNDS.isEnabled(this);

    FEATURE_NEWGROUNDS_DEBUG.apply(this, false);
    FEATURE_NEWGROUNDS_TESTING_MEDALS.apply(this, newgrounds && debugFunctions);
    FEATURE_NEWGROUNDS_AUTOLOGIN.apply(this, newgrounds && isWeb());
    FEATURE_NEWGROUNDS_EVENTS.apply(this, newgrounds);

    FEATURE_DEBUG_MENU.apply(this, editorsAvailable);
    FEATURE_ANIMATION_EDITOR.apply(this, editorsAvailable);
    FEATURE_CHART_EDITOR.apply(this, editorsAvailable);
    FEATURE_STAGE_EDITOR.apply(this, editorsAvailable);
    FEATURE_HAXEUI.apply(this, FEATURE_ANIMATION_EDITOR.isEnabled(this)
      || FEATURE_CHART_EDITOR.isEnabled(this)
      || FEATURE_STAGE_EDITOR.isEnabled(this));

    FEATURE_LAG_ADJUSTMENT.apply(this, !isWeb());
    FEATURE_SCREENSHOTS.apply(this, isDesktop());
    FEATURE_FILE_DROP.apply(this, !isMobile());
    FEATURE_TOUCH_HERE_TO_PLAY.apply(this, isWeb());

    FEATURE_HAPTICS.apply(this, isMobile());
    FEATURE_TOUCH_CONTROLS.apply(this, isMobile());
    FEATURE_GHOST_TAPPING.apply(this, isMobile());

    FEATURE_MOBILE_ADVERTISEMENTS.apply(this, mobileRelease && envConfig != null);
    FEATURE_MOBILE_IAP.apply(this, mobileRelease && envConfig != null);
    FEATURE_MOBILE_IAR.apply(this, mobileRelease);
    FEATURE_MOBILE_WEBVIEW.apply(this, isMobile() && newgrounds);
    FEATURE_MOBILE_AGESIGNALS.apply(this, mobileRelease);

    TESTING_ADS.apply(this, isDebug() && FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this));

    FEATURE_COMPRESSED_TEXTURES.apply(this, mobileRelease && !isIOSSimulator());

    renderFlagsTable();
  }

  function renderFlagsTable():Void
  {
    final check:String = "✓ ";
    final cross:String = "× ";
    final enabledFlags:Array<String> = [];
    final disabledFlags:Array<String> = [];

    for (flag in this.haxedefs.keys())
    {
      if (flag.startsWith(FeatureFlag.INVERSE_PREFIX))
      {
        disabledFlags.push(cross + flag.substr(FeatureFlag.INVERSE_PREFIX.length));
      }
      else
      {
        enabledFlags.push(check + flag);
      }
    }

    enabledFlags.sort(Reflect.compare);
    disabledFlags.sort(Reflect.compare);

    var enabledWidth:Int = 'Enabled Flags $check'.length;
    var disabledWidth:Int = 'Disabled Flags $cross'.length;

    for (flag in enabledFlags)
      enabledWidth = Std.int(Math.max(enabledWidth, flag.length));

    for (flag in disabledFlags)
      disabledWidth = Std.int(Math.max(disabledWidth, flag.length));

    final columnWidth:Int = enabledWidth + 2;
    final divider:String = "".rpad("-", columnWidth + 2 + disabledWidth);

    info(divider);
    info("FEATURE FLAGS");
    info('Enabled Flags $check'.rpad(" ", columnWidth) + "| " + 'Disabled Flags $cross');
    info(divider);

    final rows:Int = Std.int(Math.max(enabledFlags.length, disabledFlags.length));

    for (i in 0...rows)
    {
      final left:String = i < enabledFlags.length ? enabledFlags[i] : "";
      final right:String = i < disabledFlags.length ? disabledFlags[i] : "";
      info(left.rpad(" ", columnWidth) + "| " + right);
    }

    info(divider);
  }

  function configureCompileDefines():Void
  {
    setHaxedef("funkin", VERSION);
    setHaxedef("openfl-enable-handle-error");
    setHaxedef("lime_disable_assets_version");

    setHaxedef("HXCPP_CHECK_POINTER");
    setHaxedef("HXCPP_STACK_LINE");
    setHaxedef("HXCPP_STACK_TRACE");
    setHaxedef("hscriptPos");

    if (FEATURE_DEBUG_FUNCTIONS.isDisabled(this))
    {
      setHaxedef("FLX_NO_DEBUG");
      setHaxedef("analyzer-optimize");
    }

    if (FEATURE_LOG_TRACE.isDisabled(this))
    {
      setHaxedef("no-traces");
    }

    setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");

    setHaxedef("haxeui_no_mouse_reset");
    setHaxedef("haxeui_focus_out_on_click");
    setHaxedef("haxeui_dont_impose_base_class");

    if (isRelease())
    {
      setHaxedef("NAPE_RELEASE_BUILD");
    }

    setHaxedef("message.reporting", "pretty");

    if (FEATURE_DEBUG_TRACY.isEnabled(this))
    {
      setHaxedef("HXCPP_TELEMETRY");
      setHaxedef("HXCPP_TRACY");
      setHaxedef("HXCPP_TRACY_MEMORY");
      setHaxedef("HXCPP_TRACY_ON_DEMAND");
      setHaxedef("absolute-paths");
    }
  }

  function configureIncludeMacros():Void
  {
    addHaxeFlag("-dce no");

    addHaxeMacro("include('funkin', true, ['funkin.mobile.*', 'funkin.ui.debug.anim.*', 'funkin.ui.debug.charting.*', 'funkin.ui.debug.stage.*', 'funkin.ui.debug.stageeditor.*', 'funkin.ui.haxeui.*'])");

    if (isMobile())
    {
      addHaxeMacro("include('funkin.mobile')");
    }

    if (FEATURE_HAXEUI.isEnabled(this))
    {
      if (FEATURE_ANIMATION_EDITOR.isEnabled(this)) addHaxeMacro("include('funkin.ui.debug.anim')");

      if (FEATURE_CHART_EDITOR.isEnabled(this)) addHaxeMacro("include('funkin.ui.debug.charting')");

      if (FEATURE_STAGE_EDITOR.isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.stage')");
        addHaxeMacro("include('funkin.ui.debug.stageeditor')");
      }

      addHaxeMacro("include('funkin.ui.haxeui')");

      for (pack in HAXEUI_INCLUDES)
        addHaxeMacro('include(\'$pack\')');
    }

    addHaxeMacro("include('animate')");
    addHaxeMacro("include('openfl')");
    addHaxeMacro("include('lime', true, ['lime.tools.*', 'lime._internal.*'])");
    addHaxeMacro("include('flixel', true, ['flixel.addons.editors.spine.*', 'flixel.addons.nape.*', 'flixel.system.macros.*', 'flixel.addons.tile.FlxRayCastTilemap'])");
  }

  function configureCustomMacros():Void
  {
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxBasic())', 'flixel.FlxBasic')");
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxSprite())', 'flixel.FlxSprite')");
  }

  function configureOutputDir():Void
  {
    var buildDir:String = 'export/${isDebug() ? "debug" : "release"}';

    if (FEATURE_DEBUG_TRACY.isEnabled(this)) buildDir += "-tracy";

    info('Output directory: $buildDir');

    app.path = buildDir + "/";
  }

  function configureAndroid():Void
  {
    javaPaths.push(Path.join([SOURCE_DIR, ANDROID_JAVA_DIR]));

    final provider:Xml = createXml("provider", [
      "android:authorities" => '$PACKAGE_NAME.docprovider',
      "android:name" => "funkin.provider.DataFolderProvider",
      "android:grantUriPermissions" => "true",
      "android:exported" => "true",
      "android:permission" => "android.permission.MANAGE_DOCUMENTS"
    ]);

    final providerFilter:Xml = createXml("intent-filter");
    providerFilter.addChild(createXml("action", ["android:name" => "android.content.action.DOCUMENTS_PROVIDER"]));
    provider.addChild(providerFilter);

    pushManifestChild("android.application", provider);

    final fnfcFilter:Xml = createXml("intent-filter");
    fnfcFilter.addChild(createXml("action", ["android:name" => "android.intent.action.VIEW"]));

    for (category in ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"])
      fnfcFilter.addChild(createXml("category", ["android:name" => category]));

    fnfcFilter.addChild(createXml("data", ["android:mimeType" => "application/zip"]));

    for (scheme in ["file", "content"])
      fnfcFilter.addChild(createXml("data", ["android:scheme" => scheme]));

    for (pattern in buildFnfcPathPatterns())
      fnfcFilter.addChild(createXml("data", ["android:pathPattern" => pattern]));

    pushManifestChild("android.activity", fnfcFilter);

    final extensions:Null<Array<String>> = config.getArrayString("android.extension");

    for (extension in ANDROID_EXTENSIONS)
    {
      if (extensions == null || !extensions.contains(extension))
      {
        config.push("android.extension", extension);
      }
    }
  }

  function buildFnfcPathPatterns():Array<String>
  {
    final patterns:Array<String> = [];
    var prefix:String = ".*";

    for (i in 0...FNFC_MAX_DOT_DEPTH)
    {
      patterns.push(prefix + "\\.fnfc");
      prefix += "\\..*";
    }

    return patterns;
  }

  function createXml(name:String, ?attributes:Map<String, String>):Xml
  {
    final element:Xml = Xml.createElement(name);

    if (attributes != null)
    {
      for (key => value in attributes)
        element.set(key, value);
    }

    return element;
  }

  function pushManifestChild(section:String, element:Xml):Void
  {
    final printed:String = Printer.print(element, true);

    @:nullSafety(Off)
    {
      final entry:Dynamic = config.get(section);

      if (entry.xmlChildren != null)
      {
        entry.xmlChildren.push(printed);
      }
      else
      {
        entry.xmlChildren = [printed];
      }
    }
  }

  function configureIOS():Void
  {
    final documentTypes:String = File.getContent(IOS_DOCUMENT_TYPES_FILE);

    @:nullSafety(Off)
    {
      final children:Array<String> = config.getArrayString("ios.info-plist-children");
      config.set("ios.info-plist-children", children != null ? children.concat([documentTypes]) : [documentTypes]);
    }
  }

  function configurePolymod():Void
  {
    setHaxedef("POLYMOD_SCRIPT_EXT", ".hscript");
    setHaxedef("POLYMOD_SCRIPT_LIBRARY", "scripts");
    setHaxedef("POLYMOD_ROOT_PATH", "scripts/");
    setHaxedef("POLYMOD_APPEND_FOLDER", "_append");
    setHaxedef("POLYMOD_MERGE_FOLDER", "_merge");
    setHaxedef("POLYMOD_MOD_METADATA_FILE", "_polymod_meta.json");
    setHaxedef("POLYMOD_MOD_ICON_FILE", "_polymod_icon.png");

    if (isDebug()) setHaxedef("POLYMOD_DEBUG");
  }

  function configureHaxelibs():Void
  {
    addHaxelib("flixel");
    addHaxelib("flixel-addons");
    addHaxelib("polymod");
    addHaxelib("flixel-animate");
    addHaxelib("json2object");
    addHaxelib("jsonpath");
    addHaxelib("jsonpatch");
    addHaxelib("thx.core");
    addHaxelib("thx.semver");

    final haxeui:Bool = FEATURE_HAXEUI.isEnabled(this);

    addHaxelibIf(haxeui, "haxeui-core");
    addHaxelibIf(haxeui, "haxeui-flixel");
    addHaxelibIf(isDebug() && isCPP(), "hxcpp-debug-server");
    addHaxelibIf((isDesktop() || isMobile()) && FEATURE_VIDEO_PLAYBACK.isEnabled(this), "hxvlc");
    addHaxelibIf(isAndroid(), "extension-androidtools");
    addHaxelibIf(isLinux(), "hxgamemode");
    addHaxelibIf(FEATURE_DISCORD_RPC.isEnabled(this), "hxdiscord_rpc");
    addHaxelibIf(FEATURE_NEWGROUNDS.isEnabled(this), "newgrounds");
    addHaxelibIf(FEATURE_FUNKVIS.isEnabled(this), "funkin.vis");
    addHaxelibIf(FEATURE_FUNKVIS.isEnabled(this), "grig.audio");
    addHaxelibIf(FEATURE_PARTIAL_SOUNDS.isEnabled(this), "FlxPartialSound");
    addHaxelibIf(FEATURE_HAPTICS.isEnabled(this), "extension-haptics");
    addHaxelibIf(FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this), "extension-admob");
    addHaxelibIf(FEATURE_MOBILE_IAP.isEnabled(this), "extension-iapcore");
    addHaxelibIf(FEATURE_MOBILE_IAR.isEnabled(this), "extension-iarcore");
    addHaxelibIf(FEATURE_MOBILE_WEBVIEW.isEnabled(this), "extension-webviewcore");
    addHaxelibIf(FEATURE_MOBILE_AGESIGNALS.isEnabled(this), "extension-agesignals");
  }

  function configureAssets():Void
  {
    if (!(isDisplay() || isCleanCommand())) clearAssets();

    final shouldPreload:Bool = PRELOAD_ALL.isEnabled(this);
    final shouldEmbed:Bool = EMBED_ASSETS.isEnabled(this);

    var exclude:Array<String> = EXCLUDE_ASSETS.concat(isWeb() ? EXCLUDE_ASSETS_WEB : EXCLUDE_ASSETS_NATIVE);
    exclude = exclude.concat(CENSOR_EXPLETIVES.isEnabled(this) ? EXCLUDE_ASSETS_CENSORED : EXCLUDE_ASSETS_UNCENSORED);

    info(shouldEmbed ? "Embedding assets into executable..." : "Including assets alongside executable...");

    addAssetLibrary("default", shouldEmbed, true);
    addAssetPath("assets/preload", "assets", "default", ["*"], exclude, shouldEmbed, "assets");

    if (!HARDCODED_CREDITS.isEnabled(this))
    {
      addAsset("assets/exclude/data/credits.json", "assets/data/credits.json", "default", shouldEmbed);
    }

    if (!FEATURE_ANIMATION_EDITOR.isEnabled(this)) removeAssetPath("assets/preload/data/ui/animation-editor", "default");
    if (!FEATURE_CHART_EDITOR.isEnabled(this)) removeAssetPath("assets/preload/data/ui/chart-editor", "default");
    if (!FEATURE_STAGE_EDITOR.isEnabled(this)) removeAssetPath("assets/preload/data/ui/stage-editor", "default");

    addAssetPath("assets/fonts", null, "default", ["*"], exclude, true, "assets");

    addLibraryFromFolder("songs", exclude, shouldEmbed, shouldPreload);

    for (song in EMBED_SONGS_AUDIO)
    {
      removeAssetPath('assets/songs/$song');
      addAssetPath('assets/songs/$song', 'assets/songs/$song', "songs", ["*"], exclude, true, "assets");
    }

    addLibraryFromFolder("shared", exclude, shouldEmbed, shouldPreload);

    if (FEATURE_VIDEO_PLAYBACK.isEnabled(this))
    {
      addLibraryFromFolder("videos", exclude, false, shouldPreload);
    }

    for (level in LEVEL_LIBRARIES)
      addLibraryFromFolder(level, exclude, shouldEmbed, shouldPreload);

    addAssetLibrary("art", false, false);
    addAsset("art/readme.txt", "do NOT readme.txt", "art", false);
    addAsset("LICENSE.md", "LICENSE.md", "art", false);
    addAsset("CHANGELOG.md", "CHANGELOG.md", "art", false);

    info(shouldEmbed ? "Done embedding assets." : "Done including assets.");
  }

  function addLibraryFromFolder(name:String, exclude:Array<String>, embed:Bool, preload:Bool):Void
  {
    addAssetLibrary(name, embed, preload);
    addAssetPath('assets/$name', 'assets/$name', name, ["*"], exclude, embed, "assets");
  }

  function clearAssets():Void
  {
    if (!isBuild()) return;

    final exportPath:String = app.path ?? "";
    final platform:String = isMac() ? "macos" : Std.string(this.target);
    final basePath:String = Path.join([exportPath, platform, "bin"]);
    var assetsPath:String;

    switch (platformType)
    {
      case PlatformType.DESKTOP:
        assetsPath = isMac() ? Path.join([basePath, '${this.app.file}.app', "Contents", "Resources", "assets"]) : Path.join([basePath, "assets"]);
      case PlatformType.MOBILE:
        if (isAndroid() && !isBundle())
        {
          assetsPath = Path.join([basePath, "app", "src", "main", "assets", "assets"]);
        }
        else if (isIOS())
        {
          assetsPath = Path.join([exportPath, platform, '${this.app.file}', "assets", "assets"]);
        }
        else
        {
          return;
        }
      default:
        return;
    }

    if (FileSystem.exists(assetsPath))
    {
      info('Deleting assets folder from export folder ($assetsPath)');
      deleteDirectoryRecursive(assetsPath);
    }
    else
    {
      info('Assets folder does not exist ($assetsPath)');
    }
  }

  function deleteDirectoryRecursive(path:String):Void
  {
    if (!FileSystem.exists(path)) return;

    for (file in FileSystem.readDirectory(path))
    {
      final fullPath:String = Path.join([path, file]);

      if (FileSystem.isDirectory(fullPath))
      {
        deleteDirectoryRecursive(fullPath);
      }
      else
      {
        FileSystem.deleteFile(fullPath);
      }
    }

    FileSystem.deleteDirectory(path);
  }

  function configureIcons():Void
  {
    info("Configuring application icons...");

    if (isAndroid())
    {
      adaptiveIcon = new AdaptiveIcon("art/icons/android/", true);
    }
    else
    {
      for (icon in (isIOS() ? IOS_ICONS : DESKTOP_ICONS))
        addIcon(icon.path, icon.size);
    }

    info("Done configuring icons.");
  }

  function configureASTCTextures():Void
  {
    if (FEATURE_COMPRESSED_TEXTURES.isDisabled(this)) return;

    readASTCExclusion();

    if (!(isDisplay() || isCleanCommand()))
    {
      runASTCCompressor();
    }
  }

  function configureAdMobKeys():Void
  {
    if (envConfig == null) return;

    final appId:Null<String> = getEnv("ADMOB_APP_ID");

    if (appId == null)
    {
      error("ADMOB_APP_ID is not defined in the environment. Populate the .env file in your project root or build with -DNO_FEATURE_MOBILE_ADVERTISEMENTS");
      return;
    }

    setenv("ADMOB_APPID", appId);
  }

  public function isWeb():Bool
    return this.platformType == PlatformType.WEB;

  public function isMobile():Bool
    return this.platformType == PlatformType.MOBILE;

  public function isDesktop():Bool
    return this.platformType == PlatformType.DESKTOP;

  public function isConsole():Bool
    return this.platformType == PlatformType.CONSOLE;

  public function is32Bit():Bool
    return this.architectures.contains(Architecture.X86);

  public function is64Bit():Bool
    return this.architectures.contains(Architecture.X64);

  public function isWindowsHost():Bool
    return System.hostPlatform == WINDOWS;

  public function isMacHost():Bool
    return System.hostPlatform == MAC;

  public function isLinuxHost():Bool
    return System.hostPlatform == LINUX;

  public function isWindows():Bool
    return this.target == Platform.WINDOWS;

  public function isMac():Bool
    return this.target == Platform.MAC;

  public function isLinux():Bool
    return this.target == Platform.LINUX;

  public function isAndroid():Bool
    return this.target == Platform.ANDROID;

  public function isIOS():Bool
    return this.target == Platform.IOS;

  public function isIOSSimulator():Bool
    return isIOS() && this.targetFlags.exists("simulator");

  public function isCPP():Bool
    return this.defines.exists("cpp");

  public function isDisplay():Bool
    return this.command == "display";

  public function isCleanCommand():Bool
    return this.command == "clean";

  public function isCleanFlag():Bool
    return this.targetFlags.exists("clean");

  public function isRun():Bool
    return this.command == "run";

  public function isInstall():Bool
    return this.command == "install";

  public function isBuild():Bool
    return this.command == "test" || this.command == "build";

  public function isDebug():Bool
    return this.debug;

  public function isRelease():Bool
    return !isDebug();

  public function isBundle():Bool
    return isAndroid() && this.targetFlags.exists("bundle");

  public function getHaxedef(name:String):Null<Dynamic>
    return this.haxedefs.get(name);

  public function setHaxedef(name:String, ?value:String):Void
    this.haxedefs.set(name, value ?? "");

  public function unsetHaxedef(name:String):Void
    this.haxedefs.remove(name);

  public function getDefine(name:String):Null<Dynamic>
    return this.defines.get(name);

  public function hasDefine(name:String):Bool
    return this.defines.exists(name);

  public function addHaxelib(name:String, version:String = ""):Void
    this.haxelibs.push(new Haxelib(name, version));

  public function addHaxelibIf(condition:Bool, name:String, version:String = ""):Void
  {
    if (condition) addHaxelib(name, version);
  }

  public function addHaxeFlag(value:String):Void
    this.haxeflags.push(value);

  public function addHaxeMacro(value:String):Void
    addHaxeFlag('--macro ${value}');

  public function addIcon(icon:String, ?size:Int):Void
    this.icons.push(new Icon(icon, size));

  public function addAsset(path:String, ?rename:String, ?library:String, embed:Bool = false, ?padName:String):Void
  {
    if (Path.extension(path) == "png" && FEATURE_COMPRESSED_TEXTURES.isEnabled(this))
    {
      final astcPath:String = "astc-textures/" + Path.withoutExtension(path) + ".astc";

      if (!isASTCExcluded(path) && FileSystem.exists(astcPath))
      {
        path = astcPath;

        if (rename != null) rename = Path.withoutExtension(rename) + ".astc";
      }
    }

    final asset:Asset = new Asset(path, rename, null, embed, true);

    @:nullSafety(Off)
    asset.library = library ?? "default";

    if (padName != null && isBundle())
    {
      asset.deliveryPackName = padName;
    }

    this.assets.push(asset);
  }

  public function removeAsset(path:String, ?library:String):Void
  {
    for (asset in this.assets)
    {
      if (asset.sourcePath != path) continue;
      if (library != null && asset.library != library) continue;

      this.assets.remove(asset);
      return;
    }
  }

  public function addAssetPath(path:String, ?rename:String, library:String, ?include:Array<String>, ?exclude:Array<String>, embed:Bool = false,
      ?padName:String):Void
  {
    if (path == "") return;

    final includeList:Array<String> = include ?? [];
    final excludeList:Array<String> = exclude ?? [];

    var targetPath:String = rename ?? path;
    if (targetPath != "") targetPath += "/";

    if (!FileSystem.exists(path))
    {
      error('Could not find asset path "${path}".');
      return;
    }

    if (!FileSystem.isDirectory(path))
    {
      error('Could not parse asset path "${path}", expected a directory.');
      return;
    }

    for (file in FileSystem.readDirectory(path))
    {
      final fullPath:String = '${path}/${file}';

      if (FileSystem.isDirectory(fullPath))
      {
        if (this.filter(file, ["*"], excludeList))
        {
          addAssetPath(fullPath, '${targetPath}${file}', library, includeList, excludeList, embed, padName);
        }
      }
      else if (this.filter(file, includeList, excludeList))
      {
        addAsset(fullPath, '${targetPath}${file}', library, embed, padName);
      }
    }
  }

  public function removeAssetPath(path:String, ?library:String):Void
  {
    if (path == "") return;

    if (!FileSystem.exists(path))
    {
      error('Could not find asset path "${path}".');
      return;
    }

    if (!FileSystem.isDirectory(path))
    {
      error('Could not parse asset path "${path}", expected a directory.');
      return;
    }

    for (pattern in EXCLUDE_ASSETS)
    {
      if (path.contains(pattern.replace("*", ""))) return;
    }

    for (file in FileSystem.readDirectory(path))
    {
      final fullPath:String = '${path}/${file}';

      if (FileSystem.isDirectory(fullPath))
      {
        removeAssetPath(fullPath, library);
      }
      else
      {
        removeAsset(fullPath, library);
      }
    }
  }

  public function addAssetLibrary(name:String, embed:Bool = false, preload:Bool = false):Void
    this.libraries.push(new Library("", name, null, embed, preload, false, ""));

  public function buildCLICommand(cmd:String):CLICommand
    return CommandHelper.fromSingleString(cmd);

  public function buildHaxeCLICommand(path:String):CLICommand
    return CommandHelper.interpretHaxe(path);

  static function readProcess(command:String, args:Array<String>):Null<String>
  {
    try
    {
      final process:Process = new Process(command, args);
      final output:String = process.stdout.readAll().toString().trim();
      final exitCode:Int = process.exitCode(true);
      process.close();
      return exitCode == 0 ? output : null;
    }
    catch (e:Dynamic)
    {
      return null;
    }
  }

  static function runProcess(command:String, args:Array<String>):Int
  {
    try
    {
      final process:Process = new Process(command, args);
      process.stdout.readAll();
      final exitCode:Int = process.exitCode(true);
      process.close();
      return exitCode;
    }
    catch (e:Dynamic)
    {
      return -1;
    }
  }

  public function getGitCommit():String
  {
    final hash:Null<String> = readProcess("git", ["rev-parse", "HEAD"]);

    if (hash == null || hash.length == 0)
    {
      error("Could not determine current git commit; is this a proper Git repository?");
      return "";
    }

    return hash.substr(0, 7);
  }

  public function getGitBranch():String
  {
    final branch:Null<String> = readProcess("git", ["rev-parse", "--abbrev-ref", "HEAD"]);

    if (branch == null || branch.length == 0)
    {
      error("Could not determine current git branch; is this a proper Git repository?");
      return "";
    }

    return branch;
  }

  public function getGitModified():Bool
    return runProcess("git", ["diff", "--quiet"]) == 1;

  @SuppressWarnings("checkstyle:Dynamic")
  function checkLibraries():Void
  {
    final hmmPath:String = #if ios "../../../../../" + #end "hmm.json";

    if (!FileSystem.exists(hmmPath))
    {
      warn('Could not find $hmmPath, skipping library check.');
      return;
    }

    final hmmData:Dynamic = haxe.Json.parse(File.getContent(hmmPath));
    final dependencies:Array<Dynamic> = cast hmmData.dependencies;
    final mismatches:Array<{name:String, devPath:String, current:String, expected:String}> = [];

    for (library in dependencies)
    {
      final libraryName:String = cast(library.name, String).replace(".", ",");
      final libraryType:String = cast library.type;
      final devPath:String = readLibraryDev(libraryName);
      final isExternalDev:Bool = devPath != "" && !isLibraryLocalGitDev(libraryName);
      final commitHash:String = readLibraryGitCommitHash(libraryName);

      switch (libraryType)
      {
        case "haxelib":
          final expected:String = cast library.version;

          if (isExternalDev)
          {
            mismatches.push({name: libraryName, devPath: devPath, current: commitHash, expected: expected});
          }
          else
          {
            final current:String = readLibraryCurrentVersion(libraryName);
            if (current != expected) mismatches.push({name: libraryName, devPath: "", current: current, expected: expected});
          }
        case "git":
          final expected:String = cast library.ref;

          if (commitHash != expected)
          {
            mismatches.push({name: libraryName, devPath: isExternalDev ? devPath : "", current: commitHash, expected: expected});
          }
        default:
      }
    }

    if (mismatches.length == 0) return;

    warn("Some libraries differ from the versions defined in hmm.json.".bold().yellow());
    warn("To ensure consistency, it's recommended to stop the build and run `hmm reinstall [library]`.".bold().yellow());
    warn("If you're intentionally using development builds or newer versions, you can ignore this warning.".bold().yellow());

    Sys.println("");

    for (mismatch in mismatches)
    {
      final displayName:String = mismatch.name.replace(",", ".");

      if (Path.isAbsolute(mismatch.devPath))
      {
        Sys.println("- " + displayName + " (Development Build)".bright_cyan());
        Sys.println(("   Path:     " + Path.removeTrailingSlashes(mismatch.devPath)).bright_blue());
      }
      else
      {
        Sys.println("- " + displayName);
      }

      Sys.println(("   Current:  " + mismatch.current).red());
      Sys.println(("   Expected: " + mismatch.expected).green());
    }

    Sys.println("");
  }

  static function readTrimmedFile(path:String):String
    return FileSystem.exists(path) ? File.getContent(path).trim() : "";

  static function readLibraryCurrentVersion(libraryName:String):String
    return readTrimmedFile(getLibraryCurrentFile(libraryName));

  static function readLibraryDev(libraryName:String):String
    return readTrimmedFile(getLibraryDevFile(libraryName));

  static function readLibraryGitCommitHash(libraryName:String):String
  {
    final fromGit:Null<String> = readProcess("git", ["-C", getLibraryGitPath(libraryName), "rev-parse", "HEAD"]);

    if (fromGit != null && fromGit.length > 0) return fromGit;

    final devPath:String = readLibraryDev(libraryName);

    if (devPath == "") return "";

    return readProcess("git", ["-C", devPath, "rev-parse", "HEAD"]) ?? "";
  }

  static function getLocalHaxelibPath(libraryName:String, file:String):String
    return Path.join([Path.addTrailingSlash(Sys.getCwd()), ".haxelib", libraryName, file]);

  static function getLibraryCurrentFile(libraryName:String):String
    return getLocalHaxelibPath(libraryName, ".current");

  static function getLibraryDevFile(libraryName:String):String
    return getLocalHaxelibPath(libraryName, ".dev");

  static function getLibraryGitPath(libraryName:String):String
    return getLocalHaxelibPath(libraryName, "git");

  static function isLibraryLocalGitDev(libraryName:String):Bool
  {
    final gitPath:String = getLibraryGitPath(libraryName);

    if (!FileSystem.exists(gitPath) || !FileSystem.exists(getLibraryDevFile(libraryName))) return false;

    return Path.normalize(readLibraryDev(libraryName)).startsWith(Path.normalize(gitPath));
  }

  static function getLibraryPath(libraryName:String):String
    return readProcess("haxelib", ["libpath", libraryName]) ?? "";

  public function buildHxCppTools():Void
  {
    final path:String = getLibraryPath("hxcpp");

    if (path == "" || path.toLowerCase().startsWith("error") || !FileSystem.exists(path))
    {
      error("HXCPP could not be found while on C++ target.");
      return;
    }

    if (FileSystem.exists(Path.join([path, "hxcpp.n"]))) return;

    info("Compiling the HXCPP Build Tool...");

    final oldDir:String = Sys.getCwd();
    Sys.setCwd(Path.join([path, "tools/hxcpp"]));

    final exitCode:Int = runProcess("haxe", ["compile.hxml"]);

    Sys.setCwd(oldDir);

    if (exitCode == 0)
    {
      info("Compiled the HXCPP Build Tool successfully!");
    }
    else
    {
      warn("Could not compile the HXCPP Build Tool. Is HXCPP installed correctly? Continuing...");
    }
  }

  function shouldLog():Bool
    return !(isDisplay() || isCleanCommand() || isRun() || isInstall());

  public function error(message:String):Void
  {
    Sys.stderr().write(Bytes.ofString(" ERROR ".bold().bg_red() + " " + message + "\n"));
    Sys.exit(1);
  }

  public function info(message:String):Void
  {
    if (shouldLog()) Sys.println(" INFO ".bold().bg_blue() + " " + message);
  }

  public function warn(message:String):Void
  {
    if (shouldLog()) Sys.println(" WARNING ".bold().bg_yellow() + " " + message);
  }

  function getEnv(key:String):Null<String>
  {
    final env:Null<Map<String, String>> = envConfig;

    if (env == null) return null;

    final value:Null<String> = env.get(key);

    return (value == null || value.length == 0) ? null : value;
  }

  function getEnvOr(key:String, fallback:String):String
    return getEnv(key) ?? fallback;

  public function readEnvironmentFile(file:String):Null<Map<String, String>>
  {
    if (!FileSystem.exists(file))
    {
      warn('Environment file does not exist: ${file}');
      return null;
    }

    final env:Map<String, String> = new Map<String, String>();

    for (rawLine in File.getContent(file).split("\n"))
    {
      final line:String = rawLine.trim();

      if (line.length == 0 || line.startsWith("#") || shouldExcludeEnvKey(line)) continue;

      final index:Int = line.indexOf("=");

      if (index <= 0) continue;

      var value:String = line.substr(index + 1).trim();

      if (value.length >= 2 && ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))))
      {
        value = value.substr(1, value.length - 2);
      }

      if (value.length == 0) continue;

      env.set(stripEnvTargetPrefix(line.substr(0, index).trim()), value);
    }

    return env;
  }

  public function shouldExcludeEnvKey(key:String):Bool
  {
    final android:Bool = key.startsWith("ANDROID_");
    final ios:Bool = key.startsWith("IOS_");
    final mobile:Bool = key.startsWith("MOBILE_") || ios || android;
    final web:Bool = key.startsWith("WEB_");
    final desktop:Bool = key.startsWith("DESKTOP_");

    if (isWeb()) return mobile || desktop;
    if (isDesktop()) return mobile || web;
    if (isAndroid()) return ios || web || desktop;
    if (isIOS()) return android || web || desktop;

    return false;
  }

  public function stripEnvTargetPrefix(key:String):String
  {
    final index:Int = key.indexOf("_");

    if (index == -1) return key;

    final prefix:String = key.substr(0, index);
    final rest:String = key.substr(index + 1);

    final matches:Bool = switch (prefix)
    {
      case "ANDROID": isAndroid();
      case "IOS": isIOS();
      case "MOBILE": isMobile();
      case "WEB": isWeb();
      case "DESKTOP": isDesktop();
      default: false;
    }

    return matches ? rest : key;
  }

  public function readASTCExclusion():Void
  {
    if (!FileSystem.exists(ASTC_DATA_FILE))
    {
      warn('Could not find $ASTC_DATA_FILE, no ASTC exclusions will be applied.');
      astcExcludes = [];
      return;
    }

    @:nullSafety(Off)
    {
      final excludes:Array<String> = haxe.Json.parse(File.getContent(ASTC_DATA_FILE)).excludes;
      astcExcludes = excludes != null ? [for (exclusion in excludes) exclusion.trim()] : [];
    }
  }

  public function isASTCExcluded(file:String):Bool
  {
    final normalizedFile:String = Path.normalize(file);

    for (exclusion in astcExcludes)
    {
      if (exclusion.endsWith("/*"))
      {
        if (Path.directory(normalizedFile) == Path.normalize(exclusion.substr(0, exclusion.length - 2))) return true;
      }
      else if (exclusion.endsWith("/"))
      {
        if (normalizedFile.startsWith(Path.normalize(exclusion))) return true;
      }
      else if (file == exclusion)
      {
        return true;
      }
    }

    return false;
  }

  public function runASTCCompressor():Void
  {
    info("Compressing ASTC textures...");

    final args:Array<String> = ["run", "astc-compressor", "compress-from-json", "-json", ASTC_DATA_FILE];

    if (isCleanFlag()) args.push("-clean");

    Sys.command("haxelib", args);

    info("Done compressing ASTC textures.");
  }
}

abstract FeatureFlag(String) from String to String
{
  public static final INVERSE_PREFIX:String = "NO_";

  public function new(input:String)
  {
    this = input;
  }

  @:from
  public static function fromString(input:String):FeatureFlag
    return new FeatureFlag(input);

  public function apply(project:Project, enableByDefault:Bool = false):Void
  {
    if (isEnabled(project))
    {
      getInverse().disable(project, false);
    }
    else if (getInverse().isEnabled(project))
    {
      disable(project, false);
    }
    else if (enableByDefault)
    {
      enable(project, true);
    }
    else
    {
      disable(project, true);
    }
  }

  public function enable(project:Project, andInverse:Bool = true):Void
  {
    project.setHaxedef(this, "");
    if (andInverse) getInverse().disable(project, false);
  }

  public function disable(project:Project, andInverse:Bool = true):Void
  {
    project.unsetHaxedef(this);
    if (andInverse) getInverse().enable(project, false);
  }

  public function isEnabled(project:Project):Bool
    return project.haxedefs.exists(this) || project.defines.exists(this);

  public function isDisabled(project:Project):Bool
    return getInverse().isEnabled(project);

  public function getInverse():FeatureFlag
    return this.startsWith(INVERSE_PREFIX) ? this.substring(INVERSE_PREFIX.length) : INVERSE_PREFIX + this;
}
